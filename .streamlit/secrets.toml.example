# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Secrets.
TWELVE_DATA_API_KEY = "YOUR_MARKET_DATA_KEY"
# Use a persistent disk path on your host. Never commit the actual secrets file.
# GOLD_AI_STATE_DB_PATH = "/persistent/gold-ai/state.sqlite3"
LIVE_TRADING_ENABLED = false
AUTO_EXECUTION_ALLOWED = false
AUTOMATION_BACKEND_READY = false
