# انسخ هذا الملف إلى Streamlit Secrets أو إلى .streamlit/secrets.toml محليًا.
# لا ترفع أي قيمة حقيقية إلى GitHub.

# مصدر أسعار الذهب والأسهم
TWELVE_DATA_API_KEY = "ضع_مفتاح_Twelve_Data_هنا"

# فحص شرعي اختياري للأسهم
# SHARIA_APPROVED_SYMBOLS = "AAPL,MSFT"
# SHARIA_SCREEN_SOURCE = "ضع رابط المصدر"
# SHARIA_SCREEN_DATE = "YYYY-MM-DD"

# حفظ Paper — المسار الافتراضي مؤقت على بعض الاستضافات
# GOLD_AI_STATE_DB_PATH = "/persistent/gold-ai/state.sqlite3"

# حماية التداول الحقيقي — اتركها false حتى يكتمل وسيط التنفيذ
LIVE_TRADING_ENABLED = false
AUTO_EXECUTION_ALLOWED = false
AUTOMATION_BACKEND_READY = false
BROKER_CONTRACT_METADATA_VERIFIED = false

# إعدادات وسيط التنفيذ عند اكتمال Broker Bridge فقط
# BROKER_BRIDGE_URL = "https://your-private-broker-bridge.example"
# BROKER_BRIDGE_TOKEN = "ضع_الرمز_في_Secrets_فقط"
# BROKER_ACCOUNT_PATH = "/account"
# BROKER_QUOTE_PATH = "/quote"
# BROKER_ORDER_PATH = "/orders"
# BROKER_CANCEL_ALL_PATH = "/orders/cancel-all"
# BROKER_HMAC_SECRET = "ضعه_في_Secrets_فقط"
# LIVE_UI_PIN = "ضعه_في_Secrets_فقط"
